{
  "name": "@labourchain/repository",
  "version": "0.0.0",
  "private": true,
  "description": "Spec-driven Cordis repository service for LabourChain workspaces, worker relationships, records, and assets",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/labourchain/repository.git"
  },
  "homepage": "https://github.com/labourchain/repository#readme",
  "bugs": {
    "url": "https://github.com/labourchain/repository/issues"
  },
  "keywords": [
    "labourchain",
    "cordis",
    "repository",
    "workspace",
    "records",
    "assets"
  ],
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "README.md",
    "SPEC.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint src tests vitest.config.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm build",
    "pack:check": "pnpm pack --dry-run"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@types/node": "^22.20.0",
    "@vitest/coverage-v8": "^4.1.8",
    "oxlint": "1.76.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
