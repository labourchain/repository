{
  "name": "@labourchain/repository",
  "version": "0.0.0",
  "private": true,
  "description": "Spec-driven Cordis repository workspace and fact-storage capability for LabourChain",
  "keywords": [
    "labourchain",
    "cordis",
    "deepseek-harness",
    "dsh-plugin",
    "repository",
    "workspace"
  ],
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/labourchain/repository.git"
  },
  "homepage": "https://github.com/labourchain/repository#readme",
  "bugs": {
    "url": "https://github.com/labourchain/repository/issues"
  },
  "engines": {
    "node": "^22.20.0 || >=24.0.0"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "bin": {
    "labourchain-repository": "./lib/bin.js"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "lib/**/*.cue",
    "lib/**/*.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build:runtime": "tsdown --config tsdown.config.ts",
    "build:artifact": "node scripts/bootstrap-artifact.mjs build",
    "build": "pnpm run build:runtime && pnpm run build:artifact",
    "artifact:verify": "node scripts/bootstrap-artifact.mjs verify",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test \"test/**/*.test.ts\"",
    "test:coverage": "node --experimental-strip-types --experimental-test-coverage --test-coverage-exclude=\"test/**\" --test-coverage-lines=90 --test-coverage-branches=80 --test-coverage-functions=85 --test \"test/**/*.test.ts\"",
    "test:bin": "node scripts/smoke-bin.mjs",
    "check": "pnpm run typecheck && pnpm run test:coverage && pnpm run build && pnpm run test:bin && pnpm run package:check",
    "package:check": "pnpm run artifact:verify && node scripts/verify-package-contents.mjs",
    "prepack": "pnpm run check"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@types/node": "22.20.1",
    "tsdown": "0.22.14",
    "typescript": "6.0.3"
  }
}
